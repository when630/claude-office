{
  "name": "claude-office",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "로컬 Claude Code 세션들을 픽셀 사무실로 보여주는 트레이 상주 앱",
  "author": "when630 <70129021+when630@users.noreply.github.com>",
  "main": "main/index.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "icons": "node tools/make-icons.mjs",
    "usage-tap": "node tools/install-usage-tap.mjs",
    "usage-tap:remove": "node tools/install-usage-tap.mjs --remove",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "postinstall": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.when630.claude-office",
    "productName": "Claude Office",
    "publish": {
      "provider": "github",
      "owner": "when630",
      "repo": "claude-office"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "shared/**/*",
      "build/*.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "notarize": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Claude Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
